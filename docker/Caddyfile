{
    admin off
    auto_https off
}

http://:{$PORT} {
    root * /var/www/html/public

    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }

    log {
        output stdout
        format json
    }

    # Never execute PHP files uploaded into the public assets tree.
    # Laravel's sole executable front controller remains public/index.php.
    @blockedPhpFiles {
        path_regexp blockedPhp \.php(?:/|$)
        not path /index.php
    }
    respond @blockedPhpFiles 404

    php_server {
        request_body_timeout 30s
    }
}
