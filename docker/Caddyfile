{
    admin off
    auto_https off
}

http://:{$PORT} {
    root * /var/www/html/public

    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-Permitted-Cross-Domain-Policies none
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
        Cache-Control no-store
    }

    log {
        output stdout
        format json
    }

    # Named matchers are declared at site scope, then consumed by route.
    @blockedPhpFiles {
        path_regexp blockedPhp \.php(/|$)
        not path /index.php
    }

    # Keep the blocking response ahead of php_server: direct PHP files
    # under public assets must never be routed to the PHP interpreter.
    route {
        respond @blockedPhpFiles 404

        php_server {
            request_body_timeout 30s
        }
    }
}
