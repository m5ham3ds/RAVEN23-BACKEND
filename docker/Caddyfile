{
    admin off
    auto_https off
}

:{$PORT} {
    root * /var/www/html/public

    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }

    log {
        output stdout
        format json
    }

    php_server
    file_server
}
