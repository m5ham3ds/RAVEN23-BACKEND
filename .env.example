APP_NAME=RAVEN23
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Browser CORS is disabled unless exact origins are listed (comma-separated).
CORS_ALLOWED_ORIGINS=
# Exact trusted proxy IPs/CIDRs only; wildcard is rejected.
TRUSTED_PROXIES=
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Optional auth rate-limit tuning (requests per minute).
AUTH_REGISTER_IP_LIMIT=5
AUTH_REGISTER_IDENTITY_LIMIT=5
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_IDENTITY_LIMIT=10
AUTH_GOOGLE_IP_LIMIT=10
AUTH_GUEST_IP_LIMIT=10
AUTH_DEVICE_IP_LIMIT=30
AUTH_PASSWORD_RESET_IP_LIMIT=5
AUTH_PASSWORD_RESET_IDENTITY_LIMIT=3
AUTH_USERNAME_CHECK_IP_LIMIT=30
AUTH_DEVICE_MANAGEMENT_LIMIT=30
AUTH_EMAIL_VERIFICATION_IP_LIMIT=5
AUTH_EMAIL_VERIFICATION_IDENTITY_LIMIT=3
AUTH_EMAIL_VERIFICATION_EXPIRE=60
AUTH_PASSWORD_RESET_EXPIRE=60
AUTH_PASSWORD_RESET_THROTTLE=60

DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=raven23
# DB_URL is the least-privilege application role used by the web process.
DB_USERNAME=raven23
DB_PASSWORD=
# Remote PostgreSQL in production must use require, verify-ca, or verify-full.
# disable is allowed only for a loopback-only local/CI PostgreSQL test service.
DB_SSLMODE=prefer
# Separate, higher-privilege login used only by the one-off release migration task.
DB_MIGRATION_URL=

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
QUEUE_WORKER_QUEUES=mail,default
QUEUE_SLEEP=3
QUEUE_TRIES=5
QUEUE_TIMEOUT=45
QUEUE_MAX_TIME=3600
QUEUE_MEMORY=128
FILESYSTEM_DISK=local
# Private account objects use a separate non-public disk by default.
RAVEN23_PRIVATE_STORAGE_DISK=private_media

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"
# Keep disabled until a mail provider and application/deep-link URL are configured.
RAVEN23_AUTH_MAIL_ENABLED=false
RAVEN23_AUTH_ACTION_URL=

GOOGLE_CLIENT_ID=
