APP_NAME=RAVEN23
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Browser CORS is disabled unless exact origins are listed (comma-separated).
CORS_ALLOWED_ORIGINS=
# Exact trusted proxy IPs/CIDRs only; wildcard is rejected.
TRUSTED_PROXIES=
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Optional auth rate-limit tuning (requests per minute).
AUTH_REGISTER_IP_LIMIT=5
AUTH_REGISTER_IDENTITY_LIMIT=5
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_IDENTITY_LIMIT=10
AUTH_GOOGLE_IP_LIMIT=10
AUTH_GUEST_IP_LIMIT=10
AUTH_DEVICE_IP_LIMIT=30
AUTH_PASSWORD_RESET_IP_LIMIT=5
AUTH_PASSWORD_RESET_IDENTITY_LIMIT=3
AUTH_USERNAME_CHECK_IP_LIMIT=30

DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=raven23
DB_USERNAME=raven23
DB_PASSWORD=
DB_SSLMODE=prefer

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
